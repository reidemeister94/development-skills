    {
      "id": "core-direct-mechanical-change",
      "prompt": "Rename the single symbol old_name to the replacement required by this project's scoped naming rule, then verify the result with rg. This is a forced, reversible edit with no design choice.",
      "tags": [
        "core",
        "workflow",
        "direct"
      ],
      "covers": [
        "skills/using-development-skills/SKILL.md",
        "shared/development-loop.md"
      ],
      "files": {
        "AGENTS.md": "Before editing Python, read every matching rule under .agents/rules/ and state the selected source path before the first mutation.\n",
        "CLAUDE.md": "@AGENTS.md\n",
        ".agents/rules/naming.md": "---\npaths:\n  - \"src/**/*.py\"\n---\nFor this migration, the required replacement for old_name is TEAM_NAME.\n",
        "src/example.py": "old_name = 1\n"
      },
      "assertions": [
        {
          "changed_files_exact": [
            "src/example.py"
          ]
        },
        {
          "file_contains": {
            "path": "src/example.py",
            "text": "TEAM_NAME"
          }
        },
        {
          "file_not_contains": {
            "path": "src/example.py",
            "text": "old_name"
          }
        },
        {
          "transcript_contains": ".agents/rules/naming.md"
        },
        {
          "tool_not": "development-skills:brainstorming"
        },
        {
          "tool_sequence": [
            {
              "tool": "file_change",
              "field": "path",
              "contains": "src/example.py"
            },
            {
              "tool": "command_execution",
              "field": "command",
              "contains": "rg"
            }
          ]
        }
      ]
    },
    {
