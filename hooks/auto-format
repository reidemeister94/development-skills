#!/usr/bin/env bash
# Best-effort PostToolUse formatting for changed files; repository verification remains authoritative.
# Claude edit tools expose one file path. Codex apply_patch embeds multiple paths in escaped patch text,
# so that branch uses Python only to decode and extract add/update headers.

INPUT=$(cat)
paths=()

# Claude Code edit tools carry a single file_path — extract it without spawning
# a process. Paths never contain a double-quote, so [^"]* is exact.
file_path_re='"file_path"[[:space:]]*:[[:space:]]*"([^"]*)"'
if [[ "$INPUT" =~ $file_path_re ]]; then
  paths+=("${BASH_REMATCH[1]}")
elif [[ "$INPUT" == *'*** '* ]]; then
  # Codex apply_patch only. python3 un-escapes the JSON, then MULTILINE matches
  # each header in the now-real-newline command string.
  while IFS= read -r p; do
    [ -n "$p" ] && paths+=("$p")
  done < <(printf '%s' "$INPUT" | python3 -c 'import json,re,sys
try:
    cmd = (json.load(sys.stdin).get("tool_input") or {}).get("command") or ""
except Exception:
    sys.exit(0)
seen = set()
for m in re.finditer(r"^\*\*\* (?:Add|Update) File:\s*(.+)$", cmd, re.MULTILINE):
    p = m.group(1).strip()
    if p and p not in seen:
        seen.add(p)
        print(p)' 2>/dev/null)
fi

[ ${#paths[@]} -eq 0 ] && exit 0

# Find a command in PATH or node_modules/.bin/
find_cmd() {
  command -v "$1" 2>/dev/null && return
  [ -x "node_modules/.bin/$1" ] && echo "node_modules/.bin/$1" && return
  return 1
}

# Locate ruff without assuming any one Python env manager.
# PATH covers every *activated* env — conda, venv, uv, pyenv, poetry, system —
# since they all put ruff on PATH. The fallbacks cover the common *non-activated*
# layouts: $VIRTUAL_ENV (venv/uv/virtualenv/poetry/pdm), $CONDA_PREFIX (conda/
# mamba/micromamba), a project-local .venv|venv, and tool installs in ~/.local/bin
# (pipx, `uv tool`, `pip --user`). Not exhaustive — any other manager still works
# as long as ruff is reachable on PATH.
find_ruff() {
  command -v ruff 2>/dev/null && return
  for c in "${VIRTUAL_ENV:-_}/bin/ruff" "${CONDA_PREFIX:-_}/bin/ruff" \
           .venv/bin/ruff venv/bin/ruff "${HOME}/.local/bin/ruff"; do
    [ -x "$c" ] && echo "$c" && return
  done
  return 1
}

format_file() {
  local FILE_PATH="$1"
  [ ! -f "$FILE_PATH" ] && return 0
  local EXT="${FILE_PATH##*.}"
  case "$EXT" in
    py)
      RUFF=$(find_ruff) && "$RUFF" format --quiet "$FILE_PATH" 2>/dev/null || true
      ;;
    ts|tsx|js|jsx|mjs|cjs)
      FMT=$(find_cmd biome) && "$FMT" format --write "$FILE_PATH" 2>/dev/null ||
      FMT=$(find_cmd prettier) && "$FMT" --write --log-level error "$FILE_PATH" 2>/dev/null || true
      ;;
    java)
      command -v google-java-format &>/dev/null && google-java-format --replace "$FILE_PATH" 2>/dev/null || true
      ;;
    kt|kts)
      command -v ktfmt &>/dev/null && ktfmt "$FILE_PATH" 2>/dev/null ||
      command -v ktlint &>/dev/null && ktlint --format "$FILE_PATH" 2>/dev/null || true
      ;;
    swift)
      command -v swift-format &>/dev/null && swift-format format --in-place "$FILE_PATH" 2>/dev/null ||
      command -v swiftformat &>/dev/null && swiftformat "$FILE_PATH" 2>/dev/null || true
      ;;
    css|scss|less|graphql|json|jsonc)
      FMT=$(find_cmd biome) && "$FMT" format --write "$FILE_PATH" 2>/dev/null ||
      FMT=$(find_cmd prettier) && "$FMT" --write --log-level error "$FILE_PATH" 2>/dev/null || true
      ;;
    html|vue|svelte|yaml|yml)
      FMT=$(find_cmd prettier) && "$FMT" --write --log-level error "$FILE_PATH" 2>/dev/null || true
      ;;
  esac
}

for FILE_PATH in "${paths[@]}"; do
  format_file "$FILE_PATH"
done

exit 0
